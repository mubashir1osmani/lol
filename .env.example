# From Discord Developer Portal > Your app > Bot > Reset Token
DISCORD_BOT_TOKEN=replace_me

# Enable Developer Mode in Discord, then right-click the destination channel
DISCORD_CHANNEL_ID=replace_me

# Optional settings
GITHUB_REPOSITORY=BerriAI/litellm
POLL_INTERVAL_MINUTES=5
INCLUDE_PRERELEASES=true
POST_LATEST_ON_STARTUP=true

# Optional: raises the GitHub API rate limit from 60 to 5,000 requests/hour
# GITHUB_TOKEN=github_pat_replace_me
