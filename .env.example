DISCORD_BOT_TOKEN=
OSS_CONTRIBUTIONS_CHANNEL_ID=
ANNOUNCEMENTS_CHANNEL_ID=
# Start paused for the moderators-only test. Set true to enable the Friday worker.
ANNOUNCEMENTS_ENABLED=false
ROUNDUP_TIMEZONE=America/Toronto
ROUNDUP_TIME=09:00

# Leave GitHub credentials out of Render for the smallest blast radius.
# If rate limits require a token, use a dedicated fine-grained token with
# public-repository read-only access and no account/organization permissions.
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=BerriAI/litellm
# POLL_INTERVAL_MINUTES=5
# STATE_FILE=.data/contributors.json

# Confirmed mappings only. Unmapped authors are credited by GitHub username.
# Preview reports contain possible PR-sharer matches for a moderator to confirm.
# GITHUB_DISCORD_MAP={"octocat":"345678901234567890"}

# Contributor roles. Leave disabled until the README setup is done.
# This does not change who the Friday thank-you post is allowed to ping.
CONTRIBUTOR_ROLES_ENABLED=false
# DISCORD_GUILD_ID=
# DISCORD_APPLICATION_ID=
# DISCORD_PUBLIC_KEY=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=https://example.com/github/oauth/callback
# GITHUB_WEBHOOK_SECRET=
# ROLE_ANNOUNCEMENTS_CHANNEL_ID=
# ROLE_CONTRIBUTOR_ID=
# ROLE_OSS_CHAMPION_ID=
# ROLE_AGENT_BUILDER_ID=
# ROLE_PROVIDER_WIZARD_ID=
# ROLE_CONTRIBUTOR_NAME=Contributor
# ROLE_OSS_CHAMPION_NAME=OSS Champion
# ROLE_AGENT_BUILDER_NAME=Agent Builder
# ROLE_PROVIDER_WIZARD_NAME=Provider Wizard
# HTTP_HOST=0.0.0.0
# HTTP_PORT=8080
# ROLES_DB_PATH=.data/contributor_roles.db
# BACKFILL_SINCE=2023-01-01T00:00:00Z
# MERGE_SHOUTOUTS_ENABLED=true
# PR_COMMENT_INVITES_ENABLED=false
# DISCORD_INVITE_URL=https://discord.gg/example

# PR review agent. Off by default. Posts only in Discord; it does not approve,
# merge, or comment on GitHub. Needs discord.py and litellm (requirements.txt)
# and the provider key for REVIEW_MODEL (for example ANTHROPIC_API_KEY).
# The agent uses the OpenAI Agents SDK via LiteLLM. Tracing is off unless
# OPENAI_API_KEY is set or REVIEW_AGENT_TRACING=true.
# Default bot logins are cursor[bot], greptile-apps[bot], and veria-ai[bot].
# The gateway shows the bot online. Enable Guilds, Guild Messages, and Message
# Content. Server Members is requested when contributor roles are on; set
# DISCORD_MEMBERS_INTENT=false if that privileged intent is not enabled.
PR_REVIEW_ENABLED=false
# DISCORD_MEMBERS_INTENT=false
# REVIEW_MODEL=openai/gpt-4o-mini
# Channel classification. Unset uses Haiku so the main review model is not
# called on every chat line. Set this if the bot's provider is not Anthropic.
# REVIEW_CLASSIFIER_MODEL=anthropic/claude-haiku-4-5
# REVIEW_CHANNEL_IDS=1391835163780186154
# REVIEW_BOT_LOGINS=cursor[bot],greptile-apps[bot],veria-ai[bot]
# REVIEW_MAINTAINER_ROLE_ID=
# REVIEW_COOLDOWN_SECONDS=600
# REVIEW_FOLLOWUP_COOLDOWN_SECONDS=45
# REVIEW_CLASSIFY_MESSAGES=true
# REVIEW_WATCH_ALL_CHANNELS=false
# REVIEW_REQUIRE_ASK=false
# Unset, empty, or 0 means no cap. A positive number is a limit.
# REVIEW_AGENT_MAX_TOKENS counts output tokens only, not the prompt re-sent
# on every turn. Leave it unset. Steps still stop at 50.
# REVIEW_AGENT_MAX_STEPS=0
# REVIEW_AGENT_MAX_TOKENS=0
# Immediate reactions before the agent runs. Comma-separated unicode emoji,
# <:name:id>, name:id, or a guild emoji name (e.g. 👀,ty). Unset uses 👀 plus
# the guild emoji named ty / litellm_ty / thankyou / thank_you
# (case-insensitive), or 🙏 when none of those names exist.
# ACK_REACTIONS=
# GitHub user token for allowlisted review triggers (bugbot run, @greptileai).
# If unset, the bot tells the contributor which comment to post.
# GITHUB_ACTOR_TOKEN=
# REVIEW_TRIGGER_COMMENTS=bugbot run,@greptileai
# REVIEW_POST_SUMMARY=false
# REVIEW_DRY_RUN=false
# REVIEW_TRIGGER_POLL_SECONDS=120
# REVIEW_TRIGGER_WAIT_SECONDS=1200
# TypeSafe Jev (System One) decides whether a message is worth a reply.
# TYPESAFE_API_KEY=
# REVIEW_DECISION_MODEL=jev-latest
# DECISION_REPLY_THRESHOLD=0.7
# REVIEW_FAST_MODEL=anthropic/claude-haiku-4-5
# Monday community merge summary. Defaults to the OSS contributions channel.
# OSS_CONTRIBUTORS_CHANNEL_ID=
# MAINTAINER_GITHUB_LOGINS=
# MERGED_WEEKLY_ENABLED=true
# MERGED_POST_WEEKDAY=monday
# MERGED_POST_TIME=10:00
# MERGED_POST_TIMEZONE=America/Toronto
# Discord custom presence status (discord.CustomActivity).
# BOT_STATUS_TEXT=skedaddling 🏃‍♂️
# Set to true to rotate through a few fun custom statuses every 15 minutes.
# BOT_STATUS_ROTATE=false
# Wall time per run. 600 seconds by default. 0 means no wall-time cap.
# REVIEW_AGENT_TIMEOUT_SECONDS=600
# REVIEW_DAILY_RUN_BUDGET=0
# REVIEW_AGENT_TRACING=
# REVIEW_WEBHOOK_RECHECK=false
# When REVIEW_WEBHOOK_RECHECK=true and contributor roles are off, also set
# GITHUB_WEBHOOK_SECRET. Roles already require that secret.
