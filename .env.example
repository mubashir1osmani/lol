DISCORD_BOT_TOKEN=
OSS_CONTRIBUTIONS_CHANNEL_ID=
ANNOUNCEMENTS_CHANNEL_ID=
# Start paused for the moderators-only test. Set true to enable the worker.
ANNOUNCEMENTS_ENABLED=false
ROUNDUP_TIMEZONE=America/Toronto
ROUNDUP_TIME=09:00

# Leave GitHub credentials out of Render for the smallest blast radius.
# If rate limits require a token, use a dedicated fine-grained token with
# public-repository read-only access and no account/organization permissions.
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=BerriAI/litellm
# POLL_INTERVAL_MINUTES=5
# STATE_FILE=.data/contributors.json

# Confirmed mappings only. Unmapped authors are credited by GitHub username.
# Preview reports contain possible PR-sharer matches for a moderator to confirm.
# GITHUB_DISCORD_MAP={"octocat":"345678901234567890"}
